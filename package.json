{
  "name": "agent-loop-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Agent loops on Claude Code: loops that schedule roles, built, reused and optimized in the Studio, shared through a community library",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/justforyou16007/agent-loop-studio"
  },
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && npm run build:studio",
    "build:studio": "vite build --config studio/vite.config.ts --logLevel warn",
    "clean": "node tools/clean.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p studio/tsconfig.json",
    "test": "tsx",
    "pack": "npm run build && node tools/pack-contrejour.mjs",
    "lint": "oxlint src tools distribution tests studio",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^20.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@xyflow/react": "12.12.1",
    "lefthook": "2.1.6",
    "lucide-react": "1.66.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
